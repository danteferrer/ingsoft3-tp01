server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # BACKEND_URL y NGINX_RESOLVER se reemplazan al arrancar el contenedor
    # (la imagen oficial de nginx procesa este archivo con envsubst porque
    # vive en /etc/nginx/templates y termina en .template). Los valores por
    # defecto están en el Dockerfile: http://backend:8080 + DNS de Docker.
    location /api/ {
        resolver ${NGINX_RESOLVER} valid=30s ipv6=off;
        set $backend_upstream ${BACKEND_URL};
        proxy_pass $backend_upstream;
        proxy_ssl_server_name on;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
